PORT=5000

# AWS General Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# Amazon DynamoDB Tables
DYNAMODB_RIDES_TABLE=Rides
DYNAMODB_ALERTS_TABLE=UserAlerts

# Amazon S3 Queue Snapshots Bucket
QUEUE_BUCKET_NAME=your-s3-bucket-name

# Amazon Bedrock
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=

# AWS End User Messaging Social / WhatsApp Business Account (WABA)
SOCIAL_MESSAGING_REGION=eu-north-1
WABA_ID=your-waba-id
ORIGINATION_PHONE_NUMBER_ID=your-phone-number-id
ORIGINATION_PHONE_NUMBER=+918072235899

# Inbound Event Destination (SQS Poller)
WHATSAPP_INBOUND_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/123456789012/disney-whatsapp-inbound-queue

# Admin / Testing WhatsApp Phone
ADMIN_WHATSAPP_PHONE=+916380505776
