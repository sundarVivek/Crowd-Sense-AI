{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AWS": {
    "Region": "us-east-1",
    "Profile": "default",
    "Bedrock": {
      "AgentId": "YOUR_BEDROCK_AGENT_ID",
      "AgentAliasId": "YOUR_BEDROCK_AGENT_ALIAS_ID"
    },
    "EndUserMessaging": {
      "OriginationPhoneNumberId": "phone-number-id-xxxx"
    }
  },
  "AllowedHosts": "*"
}
